# ============================================
# PUBLIC ENVIRONMENT VARIABLES FOR FRONTEND
# ============================================
# Note: All variables with VITE_ prefix will be
# exposed to the browser. DO NOT store secrets here!
#
# Copy this file to .env and fill in the values.
# ============================================

# Required: WalletConnect Project ID (get from https://cloud.walletconnect.com)
VITE_WALLET_CONNECT_PROJECT_ID=your_project_id

# Contract Addresses (Sepolia — fill after deployment)
VITE_POOL_ADDRESS=0x0000000000000000000000000000000000000000
VITE_FARM_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TOKEN_A_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TOKEN_B_ADDRESS=0x0000000000000000000000000000000000000000
VITE_REWARD_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# RPC URLs (optional — built-in fallbacks exist)
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org
# VITE_MAINNET_RPC_URL=https://rpc.ankr.com/eth
