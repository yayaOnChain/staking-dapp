# ============================================
# ⚠️ SENSITIVE - NEVER COMMIT THIS FILE!
# Copy to .env.hardhat and fill in the values.
# Loaded by hardhat.config.ts for deployments.
# ============================================

# Sepolia RPC URL (get from Infura/Alchemy)
ALCHEMY_API_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Wallet private key (DO NOT COMMIT!)
#
# For Sepolia deployments: use your wallet's private key
# PRIVATE_KEY=your_sepolia_wallet_private_key
#
# For local Hardhat node: use Hardhat's default account #0
PRIVATE_KEY=your_private_key_here

# Etherscan API Key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
