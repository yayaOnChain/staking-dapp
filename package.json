{
  "name": "staking-dapp",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "clean": "npx hardhat clean",
    "clean:types": "find . -name '*.d.ts' -not -path '*/node_modules/*' -not -path '*/typechain-types/*' -not -name 'vite-env*' -type f -delete",
    "compile": "npx hardhat compile",
    "deploy:local": "npx hardhat run src/scripts/deploy.ts --network localhost",
    "deploy:sepolia": "npx hardhat run src/scripts/deploy.ts --network sepolia",
    "fund:local": "npx hardhat run src/scripts/fund-farm.ts --network localhost",
    "fund:sepolia": "npx hardhat run src/scripts/fund-farm.ts --network sepolia",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "predeploy": "npm run build && npm run lint && npm run type-check",
    "preview": "vite preview",
    "test": "npm run test:contract && npm run test:frontend",
    "test:contract": "npx hardhat test src/__tests__/contracts/*.test.ts",
    "test:frontend": "vitest run",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "typechain": "NODE_OPTIONS=\"--loader ts-node/esm --experimental-specifier-resolution=node\" hardhat typechain"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "clsx": "^2.1.1",
    "framer-motion": "^12.37.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "viem": "^2.46.2",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^4.9.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "ethers": "^6.16.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.8.3",
    "jsdom": "^28.1.0",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
